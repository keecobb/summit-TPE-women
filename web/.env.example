# Copy this file to .env.local for local development, and set the same
# two values as environment variables in the Vercel project once deployed.
#
# Deliberately NOT prefixed with NEXT_PUBLIC_ -- these are read only in
# lib/api.ts, which is marked "server-only" so Next.js refuses to build
# if it's ever imported into a Client Component. The API key never
# reaches the browser.

# The live URL of the deployed Summit TPE API (see DEPLOY.md in the
# HoopScoreImporter folder). For local dev against a locally-running
# `uvicorn api:app --reload --port 8000`, use http://localhost:8000
SUMMIT_TPE_API_URL=http://localhost:8000

# Must match SUMMIT_TPE_API_KEY set on the API deployment. Leave blank
# only if the API's SUMMIT_TPE_API_KEY is also unset (local dev default).
SUMMIT_TPE_API_KEY=
